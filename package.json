    "millify": "^6.1.0",
    "motion": "^12.34.0",
    "react": "^19.2.0",
    "react-confetti-boom": "^2.0.1",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.1.18",
    "use-debounce": "^10.1.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
